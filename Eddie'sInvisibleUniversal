    corner(knob, 11)

    local function refreshToggle()
        TweenService:Create(sw, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            BackgroundColor3 = State.Invisible and C.on or C.off,
            BackgroundTransparency = State.Invisible and 0 or 0.3,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Back), {
            Position = State.Invisible and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11),
        }):Play()
    end

    local function toggleInvisible()
        State.Invisible = not State.Invisible
        applyInvisible()
        refreshToggle()
    end

    local clk = Instance.new("TextButton", toggleCard)
    clk.Size = UDim2.new(1, 0, 1, 0)
    clk.BackgroundTransparency = 1
    clk.Text = ""
    clk.ZIndex = 2
    clk.MouseButton1Click:Connect(toggleInvisible)

