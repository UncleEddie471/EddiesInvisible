        bg        = Color3.fromRGB(16, 14, 22),
        glass     = Color3.fromRGB(26, 22, 34),
        glassHi   = Color3.fromRGB(38, 32, 48),
        card      = Color3.fromRGB(32, 26, 42),
        cardHov   = Color3.fromRGB(44, 36, 58),
        accent    = Color3.fromRGB(160, 100, 255),
        accentB   = Color3.fromRGB(100, 50, 200),
        accentSoft= Color3.fromRGB(200, 160, 255),
        border    = Color3.fromRGB(70, 55, 100),
        borderSoft= Color3.fromRGB(55, 44, 78),
        text      = Color3.fromRGB(245, 240, 255),
        dim       = Color3.fromRGB(160, 145, 190),
        white     = Color3.fromRGB(255, 255, 255),
        on        = Color3.fromRGB(160, 100, 255),
        off       = Color3.fromRGB(48, 38, 62),
        red       = Color3.fromRGB(255, 100, 120),
        green     = Color3.fromRGB(120, 230, 160),
    }

    local State = {
        Invisible = false,
        UIKey     = Enum.KeyCode.Q,
    }

    local function corner(o, r)
        local c = Instance.new("UICorner", o)
        c.CornerRadius = UDim.new(0, r or 10)
        return c
    end
    local function stroke(o, col, thick, trans)
        local s = Instance.new("UIStroke", o)
        s.Color = col or C.border
        s.Thickness = thick or 1
        s.Transparency = trans or 0
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        return s
    end
    local function gradient(o, c1, c2, rot)
        local g = Instance.new("UIGradient", o)
        g.Color = ColorSequence.new(c1, c2)
        g.Rotation = rot or 0
        return g
    end

    -- collect all visible parts
    local bodyParts = {}
    local function collectParts()
        bodyParts = {}
        for _, d in ipairs(Character:GetDescendants()) do
            if d:IsA("BasePart") and d.Transparency == 0 then
                table.insert(bodyParts, d)
            end
        end
    end

    -- toggle
    local function applyInvisible()
        for _, p in ipairs(bodyParts) do
            p.Transparency = State.Invisible and 0.5 or 0
        end
    end

