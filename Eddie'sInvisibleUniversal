        task.wait(0.25)
    end

    bStatus.Text = "Ready"
    bStatus.TextColor3 = C.green
    task.wait(0.25)
    TweenService:Create(boot, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, -0.4, 0)
    }):Play()
    TweenService:Create(veil, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
    task.wait(0.38)
    splash:Destroy()

    -- ════════════════════════════════════════════════════════════
