    local sw = Instance.new("Frame", toggleCard)
    sw.Size = UDim2.new(0, 52, 0, 28)
    sw.Position = UDim2.new(1, -68, 0.5, -14)
    sw.BackgroundColor3 = C.off
    sw.BackgroundTransparency = 0.3
    sw.BorderSizePixel = 0
    corner(sw, 14)
    stroke(sw, C.borderSoft, 1, 0.3)

    local knob = Instance.new("Frame", sw)
    knob.Size = UDim2.new(0, 22, 0, 22)
